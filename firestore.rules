rules_version = '2';

// 감사 열매 농장 보안 규칙
// - 모든 접속자는 익명 로그인
// - 진행자: 세션을 처음 연 기기 (games/{세션}/admins/{uid})
// - 반 선생님: 참여 QR의 참여 키를 알아야 반을 고를 수 있고,
//   반을 고른 기기만 그 반 이름으로 제출할 수 있다
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin(g) {
      return signedIn() && exists(/databases/$(database)/documents/games/$(g)/admins/$(request.auth.uid));
    }

    function joinKey(g) {
      return get(/databases/$(database)/documents/games/$(g)/keys/join).data.token;
    }

    function claimUid(g, c) {
      return get(/databases/$(database)/documents/games/$(g)/joins/$(joinKey(g))/claims/$(c)).data.uid;
    }

    function classIds() {
      return ['faith-1', 'faith-2', 'faith-3', 'faith-4',
              'hope-1', 'hope-2', 'hope-3', 'hope-4',
              'love-1', 'love-2', 'love-3', 'love-4'];
    }

    match /games/{g} {
      allow read: if signedIn();
      allow create, update: if isAdmin(g);
      allow delete: if false;

      // 세션을 처음 여는 기기만 진행자가 된다 (세션 문서가 생기기 전에만 등록 가능)
      match /admins/{uid} {
        allow get: if signedIn() && request.auth.uid == uid;
        allow create: if signedIn()
          && request.auth.uid == uid
          && !exists(/databases/$(database)/documents/games/$(g))
          && request.resource.data.keys().hasOnly(['at']);
        allow list, update, delete: if false;
      }

      match /classes/{c} {
        allow read: if signedIn();
        allow write: if isAdmin(g);
      }

      // 참여 키 — 진행자만 읽는다 (QR에 담긴다)
      match /keys/{k} {
        allow read, write: if isAdmin(g);
      }

      match /snaps/{s} {
        allow read, write: if isAdmin(g);
      }

      // 반 선택: 참여 키를 경로로 알아야 읽고 만들 수 있다
      match /joins/{key}/claims/{c} {
        allow read: if signedIn() && (isAdmin(g) || key == joinKey(g));
        allow create: if signedIn()
          && key == joinKey(g)
          && c in classIds()
          && request.resource.data.keys().hasOnly(['uid', 'at'])
          && request.resource.data.uid == request.auth.uid;
        allow delete: if isAdmin(g) || (signedIn() && resource.data.uid == request.auth.uid);
        allow update: if false;
      }

      // 제출 문서 ID = {라운드}_{종류}_{반}
      match /subs/{sid} {
        allow get: if isAdmin(g) || (signedIn() && claimUid(g, sid.split('_')[2]) == request.auth.uid);
        allow list, delete: if isAdmin(g);
        allow create, update: if validSub(g, sid);
      }

      function validSub(g, sid) {
        let d = request.resource.data;
        let game = get(/databases/$(database)/documents/games/$(g)).data;
        let cls = get(/databases/$(database)/documents/games/$(g)/classes/$(d.classId)).data;
        return signedIn()
          && d.keys().hasOnly(['classId', 'round', 'kind', 'value', 'at'])
          && d.round is int
          && sid == string(d.round) + '_' + d.kind + '_' + d.classId
          && claimUid(g, d.classId) == request.auth.uid
          && d.round == game.round
          && (
            (d.kind == 'quiz' && game.phase == 'quiz_open'
              && d.value in ['O', 'X', '1', '2', '3', '4'])
            ||
            (d.kind == 'store' && game.phase == 'store_open'
              && d.value is int && d.value >= 0 && d.value <= cls.fruit)
          );
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
